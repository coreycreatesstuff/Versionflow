<Application x:Class="VersionFlow.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:VersionFlow.App.Helpers">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/DarkTheme.xaml" />
        <ResourceDictionary Source="Themes/Icons.xaml" />
        <ResourceDictionary Source="Themes/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
      <helpers:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
      <helpers:NullToVisibilityConverter x:Key="NullToVis" />
      <helpers:NullToVisibilityConverter x:Key="InvNullToVis" Invert="True" />
      <helpers:EnumDisplayConverter x:Key="EnumDisplay" />
      <helpers:EqualityConverter x:Key="EqConv" />
      <helpers:StatusBrushConverter x:Key="StatusBrush" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
