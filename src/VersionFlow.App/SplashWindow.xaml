<Window x:Class="VersionFlow.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VersionFlow"
        Width="440" Height="270"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

  <Grid Margin="18">
    <Border x:Name="CardRoot"
            CornerRadius="16"
            BorderThickness="1"
            Opacity="0">
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#5B3CC4" Offset="0" />
          <GradientStop Color="#2A2838" Offset="0.6" />
          <GradientStop Color="#393552" Offset="1" />
        </LinearGradientBrush>
      </Border.BorderBrush>
      <Border.Background>
        <RadialGradientBrush Center="0.5,0.15" GradientOrigin="0.5,0.15" RadiusX="0.85" RadiusY="0.9">
          <GradientStop Color="#231B3D" Offset="0" />
          <GradientStop Color="#12121A" Offset="0.65" />
          <GradientStop Color="#0D0D12" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.65" />
      </Border.Effect>
      <Border.RenderTransform>
        <ScaleTransform x:Name="CardScale" ScaleX="0.95" ScaleY="0.95" CenterX="202" CenterY="117" />
      </Border.RenderTransform>

      <Grid Margin="28,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <Image x:Name="LogoImage"
                 Source="Assets/VersionFlow.png"
                 Width="68" Height="68"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,14">
            <Image.RenderTransform>
              <ScaleTransform x:Name="LogoScale" ScaleX="0.9" ScaleY="0.9" CenterX="34" CenterY="34" />
            </Image.RenderTransform>
          </Image>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="VersionFlow"
                       FontFamily="Inter, Segoe UI Variable Display, Segoe UI"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="#F4F4F8" />
            <Border Background="#241B3F" BorderBrush="#4C388A" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="1.0" FontSize="10.5" FontWeight="SemiBold" Foreground="#C4B5FD" />
            </Border>
          </StackPanel>

          <TextBlock Text="Create forward. Convert backward."
                     FontSize="12.5"
                     Foreground="#A7A7BC"
                     HorizontalAlignment="Center"
                     Margin="0,5,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
          <Grid Height="4" ClipToBounds="True">
            <Border Background="#20202D" CornerRadius="2" />
            <Border x:Name="ProgressBarFill" Width="110" Height="4" CornerRadius="2" HorizontalAlignment="Left">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#7C3AED" Offset="0" />
                  <GradientStop Color="#C4B5FD" Offset="0.5" />
                  <GradientStop Color="#8B5CF6" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.RenderTransform>
                <TranslateTransform x:Name="SweepTransform" X="-110" />
              </Border.RenderTransform>
            </Border>
          </Grid>
          <TextBlock x:Name="StatusText"
                     Text="Initializing compatibility engine..."
                     FontSize="11"
                     Foreground="#737388"
                     HorizontalAlignment="Center"
                     Margin="0,8,0,0" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
