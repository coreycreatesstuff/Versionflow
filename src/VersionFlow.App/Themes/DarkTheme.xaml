<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Elevated Dark Design System (Deep Layered Depth) -->
  <Color x:Key="BaseBgColor">#0A0A0F</Color>
  <Color x:Key="SecondaryBgColor">#101017</Color>
  <Color x:Key="SurfaceColor">#161621</Color>
  <Color x:Key="ElevatedSurfaceColor">#1F1F2E</Color>
  <Color x:Key="BorderColor">#29273A</Color>
  <Color x:Key="BorderHoverColor">#423E5C</Color>
  <Color x:Key="AccentColor">#8B5CF6</Color>
  <Color x:Key="AccentDeepColor">#7344E8</Color>
  <Color x:Key="AccentHoverColor">#9D74FF</Color>
  <Color x:Key="AccentLightColor">#C4B5FD</Color>
  <Color x:Key="AccentTintColor">#231B3D</Color>
  <Color x:Key="TextPrimaryColor">#F5F5FA</Color>
  <Color x:Key="TextSecondaryColor">#ABAAC0</Color>
  <Color x:Key="TextMutedColor">#727289</Color>
  <Color x:Key="SuccessColor">#34D399</Color>
  <Color x:Key="WarningColor">#FBBF24</Color>
  <Color x:Key="ErrorColor">#F87171</Color>
  <Color x:Key="InfoColor">#60A5FA</Color>

  <SolidColorBrush x:Key="BaseBgBrush" Color="{StaticResource BaseBgColor}" />
  <SolidColorBrush x:Key="SecondaryBgBrush" Color="{StaticResource SecondaryBgColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource ElevatedSurfaceColor}" />
  <SolidColorBrush x:Key="BorderBrushSubtle" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
  <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentTintColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

  <LinearGradientBrush x:Key="PrimaryCtaGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#966BF8" Offset="0" />
    <GradientStop Color="#7744DF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PrimaryCtaHoverGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#A882FA" Offset="0" />
    <GradientStop Color="#8959EC" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardSurfaceGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1A1A27" Offset="0" />
    <GradientStop Color="#14141E" Offset="1" />
  </LinearGradientBrush>
  <!-- Top-lit bevel border for Raycast/Linear depth -->
  <LinearGradientBrush x:Key="CardBevelBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#38354D" Offset="0" />
    <GradientStop Color="#252334" Offset="0.35" />
    <GradientStop Color="#1E1C2B" Offset="1" />
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="CanvasAmbientGlow" Center="0.45,-0.1" GradientOrigin="0.45,-0.1" RadiusX="0.7" RadiusY="0.55">
    <GradientStop Color="#198B5CF6" Offset="0" />
    <GradientStop Color="#000A0A0F" Offset="1" />
  </RadialGradientBrush>
</ResourceDictionary>
